# Copy this file to .env for local development. The committed example contains
# safe defaults only; the real .env file is ignored because it may later hold secrets.
APP_NAME=SmartGroceryAI
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI chat model configuration. Add your real key only to the untracked .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
