# Copy this file to .env for local development. The committed example contains
# safe defaults only; the real .env file is ignored because it may later hold secrets.
APP_NAME=SmartGroceryAI
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI chat model configuration. Add your real key only to the untracked .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Apify's hosted MCP server uses Streamable HTTP. Generate a URL that exposes the
# intended Flipp Actor in Apify's MCP configurator, then uncomment both settings.
# APIFY_MCP_SERVER_URL=https://mcp.apify.com?tools=your-flipp-actor
# APIFY_API_TOKEN=your-apify-token
APIFY_MCP_TOOL_TIMEOUT_SECONDS=120

# Application-enforced request budgets. Automatic paid Actor retries remain disabled.
SEARCH_MAX_ITEMS_PER_REQUEST=20
SEARCH_MAX_EXTERNAL_ACTOR_CALLS_PER_REQUEST=3
SEARCH_MAX_CONCURRENCY=1
